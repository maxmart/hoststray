# Copy to ".env" and fill in to sign and notarize macOS builds.
# .env is gitignored — never commit real credentials.
# scripts/build-mac.sh (and build-release.sh) load it automatically.

# Apple ID + app-specific password (appleid.apple.com) for notarization
APPLE_ID=               # your Apple ID email
APPLE_PASSWORD=         # an app-specific password
APPLE_TEAM_ID=          # your 10-char Team ID

# Optional: the exact "Developer ID Application" identity to sign with.
# Default: the one in your keychain for APPLE_TEAM_ID.
APPLE_SIGN_IDENTITY=

# Optional: also build a signed .pkg installer (needs a "Developer ID
# Installer" cert in the keychain). Use the name from `security find-identity -v`.
APPLE_INSTALLER_IDENTITY=   # e.g. Developer ID Installer: Your Org (TEAMID)
