# Copy to ".env" and fill in to enable signed/published builds.
# .env is gitignored — never commit real credentials.
# Load it into your shell before running `npm run make` / `npm run publish`,
# e.g. with `dotenv -- npm run publish` (npm i -D dotenv-cli).

# ---------------------------------------------------------------------------
# GitHub release publishing (electron-forge publish)
# ---------------------------------------------------------------------------
# A token with `repo` scope (or fine-grained: Contents read/write on the repo).
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# macOS signing + notarization  (build on a Mac with the Developer ID cert
# installed in the login keychain). Use EITHER the API key OR the app-specific
# password block, not both.
# ---------------------------------------------------------------------------
# Option A — App Store Connect API key (recommended for CI):
APPLE_API_KEY=          # path to the AuthKey_XXXXXXXX.p8 file
APPLE_API_KEY_ID=       # the key ID
APPLE_API_ISSUER=       # the issuer UUID

# Option B — Apple ID + app-specific password:
APPLE_ID=               # your Apple ID email
APPLE_PASSWORD=         # an app-specific password (appleid.apple.com)
APPLE_TEAM_ID=          # your 10-char Team ID

# ---------------------------------------------------------------------------
# Windows signing — Azure Trusted Signing (recommended; build on Windows).
# These point signtool at the Azure dlib + metadata; Azure auth itself comes
# from AZURE_* credentials (az login or the env vars below).
# ---------------------------------------------------------------------------
AZURE_CODE_SIGNING_DLIB=   # full path to Azure.CodeSigning.Dlib.dll
AZURE_METADATA_JSON=       # full path to metadata.json (account/endpoint/cert profile)
# Azure service-principal auth (or use `az login` interactively):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Windows signing — legacy hardware-token / .pfx (alternative to Azure)
# ---------------------------------------------------------------------------
WINDOWS_CERTIFICATE_FILE=      # path to .pfx (must be hardware-backed for a public cert)
WINDOWS_CERTIFICATE_PASSWORD=
